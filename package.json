{
  "name": "ikas-theme",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "upgradeDependencies": "yarn upgrade @ikas/storefront @ikas/storefront-peer-deps",
    "dev": "next dev -p 3333",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "generate": "ikas --generate",
    "prettier:all": "npx prettier@^2.1 './**/src/**/*.(ts|tsx|css|scss)' --write",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@ikas/storefront": "^4.0.0",
    "@ikas/storefront-peer-deps": "^4.0.0",
    "lucide-react": "^0.539.0",
    "react-image-magnify": "^2.7.4",
    "react-phone-input-2": "^2.15.1",
    "react-slick": "^0.30.3",
    "slick-carousel": "^1.8.1",
    "styled-components": "^6.1.19",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.4.7",
    "@types/react-slick": "^0.23.13",
    "@types/styled-components": "^5.1.34",
    "@types/swiper": "^6.0.0",
    "cross-env": "7.0.3",
    "next-sitemap": "^4.2.3"
  },
  "resolutions": {
    "@types/react": "17.0.2",
    "@types/react-dom": "17.0.2"
